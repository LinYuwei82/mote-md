# ---- 构建 / 打包产物 ----
/dist/
/build/
/build-*/
/*_build/
# 前端运行时产物：源码在 resources/web/src/，由 CMake 按 manifest 拼接生成
/resources/web/editor.js
/resources/web/editor.css
Makefile
*.o
*.obj
*.dSYM/
*.app/

# ---- 发布包 ----
*.zip

# ---- 运行时临时文件 ----
# 编辑器靠近真实文件生成预览页时留下的隐藏文件（如 resources/samples/.mote-preview-43941.html）
.mote-preview-*
**/.mote-preview-*

# ---- macOS ----
.DS_Store

# ---- 第三方 vendored framework（打包时复制，不进仓库）----
/resources/Sparkle.framework/

# ---- 图标设计稿：字体与 Python 缓存不进仓库 ----
/icon-design/fonts/
/icon-design/__pycache__/
__pycache__/

# ---- 截图：仅保留文档引用的几张，其余为调试截图 ----
/screenshots/*
!/screenshots/imgB-package.png
!/screenshots/new-confirm.png
!/screenshots/shortcut-menu-format.png
!/screenshots/theme-light.png
!/screenshots/theme-dark.png
!/screenshots/theme-dark-find.png
!/screenshots/theme-dark-slash.png
!/screenshots/theme-light-back.png
!/screenshots/link-hover.png
!/screenshots/link-anchor-status.png
!/screenshots/link-missing-dialog.png
!/screenshots/toc-cursor-item.png
!/screenshots/toc-cursor-gap.png
!/screenshots/toc-cursor-blank.png
!/screenshots/export-browser.png
