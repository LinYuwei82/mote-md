QMainWindow {
    background: #f6f8fa;
}

QToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #d0d7de;
    padding: 7px 12px;
    spacing: 4px;
}

QToolBar QToolButton {
    padding: 7px 13px;
    border: none;
    border-radius: 6px;
    color: #1f2328;
    font-size: 16px;
}

QToolBar QToolButton:hover {
    background: #eaeef2;
}

QToolBar QToolButton:pressed {
    background: #dfe4ea;
}

QToolBar QToolButton:checked {
    background: #dbeafe;
    color: #1d4ed8;
}

QToolBar::separator {
    background: #e5e9ee;
    width: 1px;
    margin: 6px 6px;
}

QSplitter::handle {
    background: #d0d7de;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QWidget#TocPanel {
    background: #ffffff;
    border-right: 1px solid #d0d7de;
}

QLabel#TocTitle {
    color: #6a737d;
    font-size: 10pt;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 13px 16px 9px 16px;
}

QTreeWidget {
    background: transparent;
    border: none;
    padding: 0px 8px 10px 8px;
    outline: none;
    font-size: 14pt;
}

QTreeWidget::item {
    padding: 5px 2px;
    border-radius: 4px;
    color: #24292f;
}

QTreeWidget::item:hover {
    background: #f0f3f6;
}

QTreeWidget::item:selected {
    background: #dbeafe;
    color: #1d4ed8;
}

QTreeWidget::branch {
    background: transparent;
}

QTextBrowser#Preview {
    background: #ffffff;
    border: none;
    padding: 0px;
}

QTextBrowser#Preview QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QPlainTextEdit#Editor {
    background: #ffffff;
    border: none;
    color: #24292f;
    selection-background-color: #bfdbfe;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d0d7de;
    color: #6a737d;
    font-size: 12pt;
    padding: 3px 12px;
}

QStatusBar::item {
    border: none;
}
