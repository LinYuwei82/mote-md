        }
      }
    },
    {
      "name": "ordered-list-dot",
      "raw": "1. a\n2. b",
      "expect": {
        "kind": "ol",
        "content": "a\nb",
        "built": "1. a\n2. b",
        "lead": 3,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
          "h3": "### a b",
          "ul": "- a\n- b",
          "ol": "1. a\n2. b",
          "quote": "> a\n> b",
          "code": "```\na\nb\n```"
        }
      }
    },
    {
      "name": "ordered-list-paren",
      "raw": "1) a\n2) b",
      "expect": {
        "kind": "ol",
        "content": "a\nb",
        "built": "1. a\n2. b",
        "lead": 3,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
          "h3": "### a b",
          "ul": "- a\n- b",
          "ol": "1) a\n2) b",
          "quote": "> a\n> b",
          "code": "```\na\nb\n```"
        }
      }
    },
    {
      "name": "quote",
      "raw": "> a\n> b",
      "expect": {
        "kind": "quote",
        "content": "a\nb",
        "built": "> a\n> b",
        "lead": 2,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
          "h3": "### a b",
          "ul": "- a\n- b",
          "ol": "1. a\n2. b",
          "quote": "> a\n> b",
          "code": "```\na\nb\n```"
        }
      }
    },
    {
      "name": "fenced-code",
      "raw": "```python\nprint(1)\n```",
      "expect": {
        "kind": "code",
        "content": "print(1)",
        "built": "```\nprint(1)\n```",
        "lead": 10,
        "toggled": "print(1)",
        "conversions": {
          "p": "print(1)",
          "h1": "# print(1)",
          "h2": "## print(1)",
          "h3": "### print(1)",
          "ul": "- print(1)",
          "ol": "1. print(1)",
          "quote": "> print(1)",
          "code": "```python\nprint(1)\n```"
        }
      }
    },
    {
      "name": "fenced-code-no-language",
      "raw": "```\nplain\n```",
      "expect": {
        "kind": "code",
        "content": "plain",
        "built": "```\nplain\n```",
        "lead": 4,
        "toggled": "plain",
        "conversions": {
          "p": "plain",
          "h1": "# plain",
          "h2": "## plain",
          "h3": "### plain",
          "ul": "- plain",
          "ol": "1. plain",
          "quote": "> plain",
          "code": "```\nplain\n```"
        }
      }
    },
    {
      "name": "horizontal-rule-dash",
      "raw": "---",
      "expect": {
        "kind": "hr",
        "content": "",
        "built": "---",
        "lead": 0,
        "toggled": "",
        "conversions": {
          "p": "",
          "h1": "# ",
          "h2": "## ",
          "h3": "### ",
          "ul": "- ",
          "ol": "1. ",
          "quote": "> ",
          "code": "```\n\n```"
        }
      }
    },
    {
      "name": "horizontal-rule-star",
      "raw": "***",
      "expect": {
        "kind": "hr",
        "content": "",
        "built": "---",
        "lead": 0,
        "toggled": "",
        "conversions": {
          "p": "",
          "h1": "# ",
          "h2": "## ",
          "h3": "### ",
          "ul": "- ",
          "ol": "1. ",
          "quote": "> ",
          "code": "```\n\n```"
        }
      }
    },
    {
      "name": "table",
      "raw": "| a | b |\n| --- | --- |\n| 1 | 2 |",
      "expect": {
        "kind": "table",
        "content": "a b\n1 2",
        "built": "a b\n1 2",
        "lead": 0,
        "toggled": "a b\n1 2",
        "conversions": {
          "p": "a b\n1 2",
          "h1": "# a b 1 2",
          "h2": "## a b 1 2",
          "h3": "### a b 1 2",
          "ul": "- a b\n- 1 2",
          "ol": "1. a b\n2. 1 2",
          "quote": "> a b\n> 1 2",
          "code": "```\na b\n1 2\n```"
        }
      }
    },
    {
      "name": "heading-with-inline-markup",
      "raw": "## **bold** title",
      "expect": {
        "kind": "h2",
        "content": "**bold** title",
        "built": "## **bold** title",
        "lead": 3,
        "toggled": "**bold** title",
        "conversions": {
          "p": "**bold** title",
          "h1": "# **bold** title",
