{
  "suite": "blocks",
  "cases": [
    {
      "name": "paragraph",
      "raw": "hello",
      "expect": {
        "kind": "p",
        "content": "hello",
        "built": "hello",
        "lead": 0,
        "toggled": "hello",
        "conversions": {
          "p": "hello",
          "h1": "# hello",
          "h2": "## hello",
          "h3": "### hello",
          "ul": "- hello",
          "ol": "1. hello",
          "quote": "> hello",
          "code": "```\nhello\n```"
        }
      }
    },
    {
      "name": "paragraph-multiline",
      "raw": "a\nb",
      "expect": {
        "kind": "p",
        "content": "a\nb",
        "built": "a\nb",
        "lead": 0,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
          "h3": "### a b",
          "ul": "- a\n- b",
          "ol": "1. a\n2. b",
          "quote": "> a\n> b",
          "code": "```\na\nb\n```"
        }
      }
    },
    {
      "name": "heading-1",
      "raw": "# Title",
      "expect": {
        "kind": "h1",
        "content": "Title",
        "built": "# Title",
        "lead": 2,
        "toggled": "Title",
        "conversions": {
          "p": "Title",
          "h1": "# Title",
          "h2": "## Title",
          "h3": "### Title",
          "ul": "- Title",
          "ol": "1. Title",
          "quote": "> Title",
          "code": "```\nTitle\n```"
        }
      }
    },
    {
      "name": "heading-2",
      "raw": "## Two",
      "expect": {
        "kind": "h2",
        "content": "Two",
        "built": "## Two",
        "lead": 3,
        "toggled": "Two",
