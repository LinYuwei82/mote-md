// 由 CMake 生成：图标与版本号跟随 Mote.pro 的 VERSION，不再手工同步
1 ICON "app.ico"

// Common Controls v6：TaskDialogIndirect 等需要 v6，无 manifest 会加载 v5.82 并 ordinal not found
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION @MOTE_VERSION_COMMA@,0
PRODUCTVERSION @MOTE_VERSION_COMMA@,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404b0"
    {
      VALUE "FileDescription", "Mote"
      VALUE "FileVersion", "@MOTE_VERSION@"
      VALUE "InternalName", "Mote"
      VALUE "OriginalFilename", "Mote.exe"
      VALUE "ProductName", "Mote"
      VALUE "ProductVersion", "@MOTE_VERSION@"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x804, 1200
  }
}
