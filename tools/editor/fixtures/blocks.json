          "p": "Two",
          "h1": "# Two",
          "h2": "## Two",
          "h3": "### Two",
          "ul": "- Two",
          "ol": "1. Two",
          "quote": "> Two",
          "code": "```\nTwo\n```"
        }
      }
    },
    {
      "name": "heading-3",
      "raw": "### Three",
      "expect": {
        "kind": "h3",
        "content": "Three",
        "built": "### Three",
        "lead": 4,
        "toggled": "Three",
        "conversions": {
          "p": "Three",
          "h1": "# Three",
          "h2": "## Three",
          "h3": "### Three",
          "ul": "- Three",
          "ol": "1. Three",
          "quote": "> Three",
          "code": "```\nThree\n```"
        }
      }
    },
    {
      "name": "heading-6",
      "raw": "###### Six",
      "expect": {
        "kind": "h6",
        "content": "Six",
        "built": "###### Six",
        "lead": 7,
        "toggled": "Six",
        "conversions": {
          "p": "Six",
          "h1": "# Six",
          "h2": "## Six",
          "h3": "### Six",
          "ul": "- Six",
          "ol": "1. Six",
          "quote": "> Six",
          "code": "```\nSix\n```"
        }
      }
    },
    {
      "name": "unordered-list-dash",
      "raw": "- a\n- b",
      "expect": {
        "kind": "ul",
        "content": "a\nb",
        "built": "- a\n- b",
        "lead": 2,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
          "h3": "### a b",
          "ul": "- a\n- b",
          "ol": "1. a\n2. b",
          "quote": "> a\n> b",
          "code": "```\na\nb\n```"
        }
      }
    },
    {
      "name": "unordered-list-star",
      "raw": "* a\n* b",
      "expect": {
        "kind": "ul",
        "content": "a\nb",
        "built": "- a\n- b",
        "lead": 2,
        "toggled": "a\nb",
        "conversions": {
          "p": "a\nb",
          "h1": "# a b",
          "h2": "## a b",
