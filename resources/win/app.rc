// Windows 可执行文件图标资源（qmake: RC_FILE）
1 ICON "app.ico"

// 版本信息：安装包与「属性 → 详细信息」显示的 FileVersion / ProductVersion
// 这里只能手写：RC_FILE 由 rc.exe 直接编译，qmake 不会用 Mote.pro 的 VERSION 替换。
// 改版本时 FILEVERSION / PRODUCTVERSION 与两个字符串字段要一起改（当前 0.3.4）。
1 VERSIONINFO
FILEVERSION 0,3,4,0
PRODUCTVERSION 0,3,4,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404b0"
    {
      VALUE "FileDescription", "Mote"
      VALUE "FileVersion", "0.3.4"
      VALUE "InternalName", "Mote"
      VALUE "OriginalFilename", "Mote.exe"
      VALUE "ProductName", "Mote"
      VALUE "ProductVersion", "0.3.4"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x804, 1200
  }
}
