#!/usr/bin/env bash
# pre-commit hook — 多门禁（UTF-8 BOM + Ed25519 公钥一致性）
#
# 门禁 1：PowerShell 5 .ps1 必须 UTF-8 + BOM
#         Windows PowerShell 5 只正确识别带 BOM 的 .ps1；
#         无 BOM 会被按 GBK 读，中文字面量断裂 → 脚本崩溃。
#
# 门禁 2：Sparkle EdDSA 公钥硬编码一致性
#         Sparkle 验签公钥在 native/CMakeLists.txt 硬编码一处；
#         如果被误改会导致客户端更新验签静默失败。
#         这个 hook 从 ~/.config/mote-updates/sparkle_ed25519_seed.b64
#         （或 MOTE_SIGNING_KEY 环境变量指定）推导出正确公钥，
#         和代码里硬编码的值比对。
#
# 用法：git config core.hooksPath tools/hooks（见 setup-hooks.ps1）。

set -u

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
RERUN="${YELLOW}git commit --no-verify${NC}"

# ============================================================
# 门禁 1：.ps1 UTF-8 + BOM
# ============================================================
fail_count=0; checked=0
# macOS 默认 bash 3.2 无 mapfile，用 while 兼容
ps1_list=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.ps1$' || true)

if [ -n "$ps1_list" ]; then
    echo -e "${YELLOW}[hook] 门禁 1/2：.ps1 UTF-8 + BOM${NC}"
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        bom=$(git show ":$f" 2>/dev/null | head -c 3 | od -An -tx1 | tr -d ' \n')
        checked=$((checked + 1))
        if [ "$bom" = "efbbbf" ]; then
            echo -e "  ${GREEN}✓${NC} $f"
        else
            echo -e "  ${RED}✗${NC} $f 缺少 UTF-8 BOM（当前前 3 字节：$bom）"
            fail_count=$((fail_count + 1))
        fi
    done <<< "$ps1_list"
    if [ $fail_count -gt 0 ]; then
        echo -e "${RED}[hook] 阻断：${fail_count}/${checked} 个 .ps1 缺 UTF-8 BOM${NC}"
        exit 1
    fi
    echo -e "  ${GREEN}✓ 通过：${checked} 个 .ps1${NC}\n"
else
    echo -e "${GREEN}[hook] 门禁 1/2 跳过（无 .ps1 变更）${NC}"
fi

# ============================================================
# 门禁 2：Sparkle Ed25519 公钥一致性
# ============================================================
echo -e "${YELLOW}[hook] 门禁 2/2：Sparkle Ed25519 公钥一致性${NC}"

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Mote Sparkle 用 .b64 种子（不是 .pem）
SEED_FILE="${MOTE_SIGNING_KEY:-$HOME/.config/mote-updates/sparkle_ed25519_seed.b64}"

if [ ! -f "$SEED_FILE" ]; then
    echo -e "  ${YELLOW}⚠ 跳过：Sparkle 种子不存在 $SEED_FILE${NC}"
    echo -e "     设置 MOTE_SIGNING_KEY=/path/to/seed.b64 或确保默认位置存在。"
    exit 0
fi

# 从 .b64 种子推导公钥（用 Python 转 PKCS8 再 openssl 推）
if command -v openssl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    PEM_CONTENT=$(python3 - "$SEED_FILE" <<'PYEOF'
import base64, sys
seed_path = sys.argv[1]
seed_b64 = open(seed_path).read().strip()
seed = base64.b64decode(seed_b64)
pkcs8 = bytes.fromhex("302e020100300506032b657004220420") + seed
sys.stdout.write("-----BEGIN PRIVATE KEY-----\n")
sys.stdout.write(base64.b64encode(pkcs8).decode())
sys.stdout.write("\n-----END PRIVATE KEY-----\n")
PYEOF
)
    CORRECT_PUBKEY=$(echo "$PEM_CONTENT" | openssl pkey -pubout -outform DER 2>/dev/null | tail -c 32 | base64 | tr -d '\n')
    if [ -z "$CORRECT_PUBKEY" ]; then
        echo -e "  ${YELLOW}⚠ 跳过：推导出公钥为空${NC}"
        exit 0
    fi
else
    echo -e "  ${YELLOW}⚠ 跳过：系统缺 openssl 或 python3${NC}"
    exit 0
fi

echo "  正确公钥（从 Sparkle 种子推导）：$CORRECT_PUBKEY"

# 需要包含正确公钥的文件
TARGET_FILES=(
    "native/CMakeLists.txt"
)
# docs/ 扫描（仅提示）
DOCS_GLOB="docs/*.md docs/**/*.md"

target_fail=0
for f in "${TARGET_FILES[@]}"; do
    [ -f "$REPO_ROOT/$f" ] || { echo -e "  ${YELLOW}⚠${NC} $f 不存在"; continue; }
    STAGED=$(git show ":$f" 2>/dev/null || cat "$REPO_ROOT/$f" 2>/dev/null || true)
    if echo "$STAGED" | grep -qF "$CORRECT_PUBKEY"; then
        echo -e "  ${GREEN}✓${NC} $f"
    else
        ANY_KEY=$(echo "$STAGED" | grep -oE '[A-Za-z0-9+/]{43}=' | head -1 || true)
        if [ -n "$ANY_KEY" ] && [ "$ANY_KEY" != "$CORRECT_PUBKEY" ]; then
            echo -e "  ${RED}✗${NC} $f 出现公钥但与正确值不一致："
            echo -e "     正确：$CORRECT_PUBKEY"
            echo -e "     当前：$ANY_KEY"
            target_fail=$((target_fail + 1))
        else
            echo -e "  ${YELLOW}⚠${NC} $f 未出现任何 Ed25519 公钥（确认是否应包含）"
        fi
    fi
done

# docs 扫描（提示但不阻断）
echo ""
echo -e "  ${YELLOW}— docs/ 扫描（仅提示，不阻断）—${NC}"
for pat in $DOCS_GLOB; do
    for f in $REPO_ROOT/$pat; do
        [ -f "$f" ] || continue
        HIT=$(grep -nE '[A-Za-z0-9+/]{43}=' "$f" 2>/dev/null | grep -v "$CORRECT_PUBKEY" | head -2 || true)
        if [ -n "$HIT" ]; then
            echo -e "  ${YELLOW}ℹ${NC} $f 里有疑似公钥需要核对："
            echo "$HIT" | sed 's/^/     /'
        fi
    done
done

if [ $target_fail -gt 0 ]; then
    echo ""
    echo -e "${RED}[hook] 阻断：${target_fail} 处硬编码公钥与 Sparkle 种子不一致${NC}"
    echo -e "       错公钥会导致 Sparkle 验签失败，客户端更新静默拒绝。"
    echo -e "       种子文件：$SEED_FILE"
    echo -e "       绕过：$RERUN"
    exit 1
fi

echo ""
echo -e "${GREEN}[hook] 通过：门禁 1/2 + 门禁 2/2${NC}"
exit 0
